# BuddyTrails MCP — copy to .env and fill in
# cp .env.example .env

# SQLite file (default: ./buddytrails.db)
BUDDYTRAILS_DB=./buddytrails.db

# HTTP/SSE port (default: 3000)
PORT=3000

# Discord bot (optional — only if using Discord)
# Guild-only: /buddytrails-verify in a guild channel; DMs for 3★ reminders to linked users
DISCORD_TOKEN=your_bot_token_here
